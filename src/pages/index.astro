---
import BaseLayout from '../layouts/BaseLayout.astro';
import SearchBar from '../components/SearchBar';
import { POTES } from '../lib/potes';
import { getCollection } from 'astro:content';

const artigos = await getCollection('artigos');
const acoesRecorrentes = artigos.filter((a) => a.data.tipo === 'acao-recorrente');

// Um pote sem nenhum artigo ainda mostra "em construção" em vez de levar
// a pessoa a uma página vazia.
const contagemPorPote = new Map<string, number>();
for (const artigo of artigos) {
  const pote = artigo.data.pote;
  if (pote) contagemPorPote.set(pote, (contagemPorPote.get(pote) ?? 0) + 1);
}
---

<BaseLayout title="Início" buscaNoHeader={false}>
  <section class="max-w-prose">
    <h1 class="font-serif text-3xl leading-tight text-ink-primary md:text-4xl">
      Tudo o que o grupo já explicou sobre investir, em um lugar só.
    </h1>
    <p class="mt-4 text-lg leading-relaxed text-ink-secondary">
      Regras, o porquê de cada decisão, e as obrigações que você precisa lembrar sozinho —
      como declarar o imposto na venda de um FII.
    </p>
  </section>

  <!-- Dois caminhos de entrada, lado a lado: busca para quem sabe o que
       procura, potes para quem não tem nada específico em mente. -->
  <section class="mt-8">
    <SearchBar client:load variante="destaque" />
  </section>

  <section class="mt-14">
    <h2 class="font-serif text-2xl text-ink-primary">Os potes</h2>
    <p class="mt-2 max-w-prose text-ink-secondary">
      O caminho para construir patrimônio é preencher potes, cada um com um tipo de
      investimento e uma função diferente. Eles estão na ordem em que se constrói.
    </p>

    <ol class="mt-6 grid gap-4 md:grid-cols-3">
      {
        POTES.map((pote, i) => {
          const total = contagemPorPote.get(pote.id) ?? 0;
          return (
            <li>
              <a
                href={`/potes/${pote.id}`}
                class="flex h-full flex-col rounded-xl border border-base-border bg-white p-5 transition hover:border-teal-200 hover:shadow-sm"
              >
                <span class="font-serif text-2xl text-teal-400">{i + 1}</span>
                <p class="mt-2 font-medium text-ink-primary">{pote.nome}</p>
                <p class="mt-0.5 text-sm font-medium text-teal-600">{pote.contem}</p>
                <p class="mt-3 flex-1 text-sm leading-relaxed text-ink-secondary">
                  {pote.resumo}
                </p>
                <p class="mt-4 text-xs text-ink-muted">
                  {total === 0
                    ? 'Em construção'
                    : total === 1
                      ? '1 artigo'
                      : `${total} artigos`}
                </p>
              </a>
            </li>
          );
        })
      }
    </ol>
  </section>

  {
    acoesRecorrentes.length > 0 && (
      <section class="mt-14">
        <h2 class="font-serif text-2xl text-ink-primary">Ações que você precisa lembrar</h2>
        <p class="mt-2 max-w-prose text-ink-secondary">
          Coisas que não acontecem automaticamente — é você quem precisa agir.
        </p>
        <ul class="mt-6 space-y-3">
          {acoesRecorrentes.map((a) => (
            <li>
              <a
                href={`/artigos/${a.slug}`}
                class="block rounded-xl border border-amber-100 bg-amber-50 p-4 transition hover:border-amber-200"
              >
                <p class="font-medium text-amber-800">{a.data.title}</p>
                <p class="mt-1 text-sm text-amber-800/80">{a.data.descricao}</p>
                {a.data.prazo && (
                  <p class="mt-2 text-xs font-medium text-amber-800">Prazo: {a.data.prazo}</p>
                )}
              </a>
            </li>
          ))}
        </ul>
      </section>
    )
  }

  <section class="mt-14 border-t border-base-border pt-6">
    <a href="/artigos" class="text-sm text-teal-600 hover:text-teal-800">
      Ver todos os artigos ({artigos.length}) →
    </a>
  </section>
</BaseLayout>
