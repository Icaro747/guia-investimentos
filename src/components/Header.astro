---
import SearchBar from './SearchBar';

interface Props {
  // A home mostra a busca em destaque no corpo da página, então o header
  // esconde a dele — dois campos idênticos na mesma tela confundem.
  mostrarBusca?: boolean;
}

const { mostrarBusca = true } = Astro.props;
---

<header class="border-b border-base-border bg-base-bg">
  <div class="mx-auto max-w-4xl px-4 py-4">
    <div class="flex flex-wrap items-center justify-between gap-4">
      <a href="/" class="font-serif text-xl text-ink-primary">
        Guia de investimentos
      </a>
      <nav class="flex gap-5 text-sm text-ink-secondary">
        <a href="/" class="hover:text-teal-600">Início</a>
        <a href="/glossario" class="hover:text-teal-600">Glossário</a>
        <a href="/atualizacoes" class="hover:text-teal-600">Atualizações</a>
        <a href="/como-usar" class="hover:text-teal-600">Como usar</a>
      </nav>
    </div>
    {
      mostrarBusca && (
        <div class="mt-4 max-w-lg">
          <SearchBar client:load />
        </div>
      )
    }
  </div>
</header>
